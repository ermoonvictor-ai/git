# Copy this file to .env and fill in real values before running docker compose.
# Never commit the real .env file.

# Public domain the server will be reached at, e.g. chat.example.com
DOMAIN=chat.example.com

# Matrix server name (usually same as DOMAIN). This is baked into every user
# ID (@user:SERVER_NAME) and room ID at first startup — changing it later
# means starting over, so pick the final value now.
SERVER_NAME=chat.example.com

# Email used by Caddy for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com

# Postgres credentials for Synapse's database (internal to the docker network).
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=synapse

# Shared secret used to mint registration tokens / admin API calls.
# Generate with: openssl rand -hex 32
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me-to-a-long-random-value

# Shared secret coturn uses to authenticate with Synapse for TURN (voice/video
# call relaying through NAT). Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=change-me-to-a-long-random-value

# Public IP of this server, used by coturn to advertise relay candidates.
EXTERNAL_IP=203.0.113.10
